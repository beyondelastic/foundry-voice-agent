# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Name of the voice agent that create_agent.py creates and app.py talks to
FOUNDRY_VOICE_AGENT_NAME=lab-voice-assistant

# Service-managed model (no deployment needed). Use a realtime speech-to-speech
# model such as gpt-realtime, or a supported text model for a cascaded pipeline.
FOUNDRY_VOICE_AGENT_MODEL=gpt-realtime

# Azure standard voice used for the agent's spoken replies
FOUNDRY_VOICE_AGENT_VOICE=en-US-AvaNeural
